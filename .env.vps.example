# .env para o deploy co-locado na VPS da daltonlab (docker-compose.vps.yml).
# Copie para .env na VPS: cp .env.vps.example .env

# Porta publicada no host. Acesso final: http://<IP_DA_VPS>:8080
# Precisa estar liberada no Cloud Firewall do Hetzner (inbound TCP).
AT_HOST_PORT=8080

# Limites de recurso na VPS pequena (2 vCPU / 3.7 GB, dividida com o CouchDB).
AT_MEM_LIMIT=2g
AT_CPUS=1.5

# Chunks transcritos em paralelo. 2 é seguro nessa VPS; suba se ela crescer.
AUDIO_TRANSCRIPT_PARALLELISM=2

# Limite de upload (bytes). 524288000 = 500MB.
AUDIO_TRANSCRIPT_MAX_UPLOAD_BYTES=524288000

# Apaga jobs com mais de N dias (0 desativa).
AUDIO_TRANSCRIPT_RETENTION_DAYS=7

# hCaptcha — deixe vazio (ferramenta interna). Preencha se for expor ao público.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# AdSense — não se aplica em deploy interno. Deixe vazio.
ADSENSE_CLIENT_ID=
