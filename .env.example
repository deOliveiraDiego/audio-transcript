# Domain (used by Caddy for HTTPS). Use 'localhost' for local testing.
DOMAIN=transcrever.example.com

# Email for Let's Encrypt account
ACME_EMAIL=you@example.com

# Upload size cap (bytes). 524288000 = 500MB.
AUDIO_TRANSCRIPT_MAX_UPLOAD_BYTES=524288000

# Parallel chunks during transcription (raise for big VPSes).
AUDIO_TRANSCRIPT_PARALLELISM=4

# Auto-delete jobs older than N days (0 to disable).
AUDIO_TRANSCRIPT_RETENTION_DAYS=7

# hCaptcha (free tier at hcaptcha.com). Leave blank to disable captcha.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Google AdSense publisher ID. Format: ca-pub-XXXXXXXXXXXXXXXX.
# Leave blank to render ad slots as empty placeholders.
ADSENSE_CLIENT_ID=
